  "tikhub": {
    "_说明": "用 TikHub 抓小红书、抖音、TikTok、YouTube、B站。只找 AI 新玩法、使用技巧、爆款形式和一人公司需求，不当新闻源，所以不抓热搜榜（原配置在 _停用的热搜榜）。没配置 TIKHUB_API_KEY 时自动跳过。按每次请求约 0.001 美元算，max_requests 是每天上限（失败的请求不收费，也不计数）。每个平台的关键词分三组：monitor 是长期监测，每天都搜，但日报只报新增的帖子和数字变化（脚本会把前 7 天出现过的帖子标上 seen_before）；probe 是轮换探针，每天按顺序取 probe_per_day 个，一周左右轮一遍；追搜词来自前一天日报的 watch_next（模型写的「明天追搜」工具名），只在 fresh_platforms 上搜。params 里 {week_ago}、{now} 会换成时间戳；relax 列出的参数在请求被拒时去掉再试一次。",
    "max_requests": 50,
    "keep_per_search": 10,
    "fresh_platforms": ["小红书", "抖音", "YouTube"],
    "fresh_max": 3,
    "hot_lists": [],
    "_停用的热搜榜": [
      {"name": "抖音热搜", "platform": "抖音", "path": "/api/v1/douyin/app/v3/fetch_hot_search_list"},
      {"name": "微博热搜", "platform": "微博", "path": "/api/v1/weibo/web_v2/fetch_hot_search"},
      {"name": "知乎热榜", "platform": "知乎", "path": "/api/v1/zhihu/web/fetch_hot_list", "params": {"limit": "50"}},
      {"name": "B站热搜", "platform": "B站", "path": "/api/v1/bilibili/web/fetch_hot_search", "params": {"limit": "50"}},
      {"name": "TikTok 趋势搜索词", "platform": "TikTok", "path": "/api/v1/tiktok/web/fetch_trending_searchwords"}
    ],
    "searches": [
      {"platform": "小红书", "path": "/api/v1/xiaohongshu/app_v2/search_notes", "keyword_param": "keyword",
       "params": {"page": 1, "sort_type": "popularity_descending", "time_filter": "一周内", "note_type": "不限"},
       "relax": ["time_filter", "note_type"],
       "monitor": ["AI副业", "AI工作流"], "probe_per_day": 2,
       "probe": ["外贸获客", "跨境电商 AI", "AI使用技巧", "AI提示词", "Claude Code", "AI做小红书", "AI写作变现", "一人公司", "AI接单", "AI知识付费", "独立站 AI", "亚马逊 AI 工具", "AI SEO", "智能体教程", "AI效率神器"]},
      {"platform": "抖音", "path": "/api/v1/douyin/search/fetch_video_search_v2", "method": "POST", "keyword_param": "keyword",
       "params": {"cursor": 0, "sort_type": "0", "publish_time": "7", "filter_duration": "0", "content_type": "0", "search_id": ""},
       "relax": ["publish_time", "content_type"],
       "monitor": ["AI漫剧", "AI数字人"], "probe_per_day": 2,
       "probe": ["AI副业", "AI新玩法", "AI工具推荐", "AI短视频教程", "AI带货", "AI智能体", "一人公司", "AI自媒体", "AI变现", "外贸 AI", "跨境电商 AI", "AI使用技巧"]},
      {"platform": "TikTok", "path": "/api/v1/tiktok/app/v3/fetch_video_search_result", "keyword_param": "keyword",
       "params": {"offset": 0, "count": 20, "sort_type": 1, "publish_time": 7, "region": "US"},
       "relax": ["publish_time", "region"],
       "monitor": ["faceless channel", "AI side hustle"], "probe_per_day": 2,
       "probe": ["AI hacks", "ChatGPT tips", "Claude tips", "AI automation", "AI UGC", "AI tools", "make money online AI", "AI business ideas", "AI dropshipping", "print on demand AI"]},
      {"platform": "YouTube", "path": "/api/v1/youtube/web/search_video", "keyword_param": "search_query",
       "params": {"language_code": "en", "country_code": "us"},
       "monitor": ["faceless youtube channel AI", "AI automation agency"], "probe_per_day": 2,
       "probe": ["Claude Code tips", "one person business AI", "n8n automation", "AI SEO", "AI agents make money", "vibe coding", "AI workflow tutorial", "programmatic SEO AI", "AI cold email", "Shopify AI automation", "ChatGPT hacks"]},
      {"platform": "B站", "path": "/api/v1/bilibili/web/fetch_general_search", "keyword_param": "keyword",
       "params": {"order": "click", "page": 1, "page_size": 20, "pubtime_begin_s": "{week_ago}", "pubtime_end_s": "{now}"},
       "relax": ["pubtime_begin_s", "pubtime_end_s"],
       "monitor": ["AI 副业", "Claude Code"], "probe_per_day": 2,
       "probe": ["AI 编程", "AI 工作流", "n8n", "AI 自媒体", "AI 技巧", "Cursor 教程", "AI 跨境电商", "AI 外贸"]}
    ],
    "comments": {
